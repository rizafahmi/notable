<!DOCTYPE html>
<html lang="id" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Notable" suffix=" · Notable">
      {assigns[:page_title]}
    </.live_title>

    <meta :if={assigns[:meta_description]} name="description" content={@meta_description} />
    <meta :if={assigns[:meta_robots]} name="robots" content={@meta_robots} />
    <link :if={assigns[:canonical_url]} rel="canonical" href={@canonical_url} />

    <link rel="icon" href={~p"/favicon.ico"} sizes="32x32" />
    <link rel="icon" href={~p"/favicon.svg"} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <link rel="mask-icon" href={~p"/icon-mask.svg"} color="#00CADB" />
    <link rel="manifest" href={~p"/site.webmanifest"} />
    <meta name="theme-color" content="#040A0F" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={assigns[:page_title] || "Notable"} />
    <meta :if={assigns[:meta_description]} property="og:description" content={@meta_description} />
    <meta :if={assigns[:canonical_url]} property="og:url" content={@canonical_url} />
    <meta property="og:site_name" content="Notable" />
    <meta :if={assigns[:og_image]} property="og:image" content={@og_image} />
    <meta :if={assigns[:og_image]} property="og:image:width" content="1200" />
    <meta :if={assigns[:og_image]} property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta
      name="twitter:card"
      content={if assigns[:og_image], do: "summary_large_image", else: "summary"}
    />
    <meta name="twitter:title" content={assigns[:page_title] || "Notable"} />
    <meta :if={assigns[:meta_description]} name="twitter:description" content={@meta_description} />
    <meta :if={assigns[:og_image]} name="twitter:image" content={@og_image} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/sw_register.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
